rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfSignupRole(role) {
      return role in ['student', 'senior', 'faculty'];
    }

    match /users/{userId} {
      // Users can read their own profile; admins can review all profiles.
      // Public mentor profiles are readable only after admin verification and publication.
      allow read: if isOwner(userId) || isAdmin() || (resource.data.role in ['senior', 'faculty'] && resource.data.mentorData.verified == true && resource.data.mentorData.isPublished == true);

      // A user can only create their own profile, and self-signup can never create admins.
      allow create: if isOwner(userId)
        && isSelfSignupRole(request.resource.data.role);

      // Users may edit their own profile; only admins may edit other profiles.
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role && request.resource.data.mentorData.verified == resource.data.mentorData.verified && request.resource.data.mentorData.isPublished == resource.data.mentorData.isPublished);

      allow delete: if isAdmin();
    }

    match /clubs/{clubId} {
      // Students/public users can only read records explicitly published by an admin.
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
