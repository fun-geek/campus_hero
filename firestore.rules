rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSelfSignupRole(role) {
      return role in ['student', 'senior', 'faculty'];
    }

    match /users/{userId} {
      // Public profile reads are retained for the existing mentor directory.
      allow read: if true;

      // A user can only create their own profile, and self-signup can never create admins.
      allow create: if isOwner(userId)
        && isSelfSignupRole(request.resource.data.role);

      // Users may edit their own profile; only admins may edit other profiles.
      allow update: if isOwner(userId) || isAdmin();

      allow delete: if isAdmin();
    }

    match /clubs/{clubId} {
      // Students/public users can only read records explicitly published by an admin.
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
